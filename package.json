{
  "name": "geolibre-kml-kmz-import",
  "version": "0.2.1",
  "description": "Production-oriented KML and KMZ import plugin for GeoLibre.",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && vite build --config vite.geolibre.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests vite.geolibre.config.ts",
    "package:geolibre": "npm run build && node scripts/package-geolibre-plugin.mjs",
    "validate:package": "node scripts/validate-package.mjs"
  },
  "keywords": [
    "geolibre",
    "kml",
    "kmz",
    "gis",
    "maplibre",
    "geospatial",
    "plugin"
  ],
  "author": "helsharif",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/helsharif/geolibre-kml-kmz-import.git"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/geojson": "^7946.0.16",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
